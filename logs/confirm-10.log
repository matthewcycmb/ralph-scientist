   201	def build_prompt(doc_sentences, question: str) -> str:
   202	    parts = [f"<|im_start|>system\n{SYSTEM_MSG}<|im_end|>\n<|im_start|>user\n"]
   203	    if doc_sentences:
   204	        parts.append("Document:\n" + " ".join(doc_sentences) + "\n\n")
   205	    parts.append(f"Question: {question}\nAnswer with the code only.<|im_end|>"
   206	                 f"\n<|im_start|>assistant\n")
   207	    return "".join(parts)
