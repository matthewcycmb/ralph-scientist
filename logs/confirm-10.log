   167	        keys = sorted(set(lm) & set(rm))
   168	        wins = sum((not lm[k]["accurate"]) and rm[k]["accurate"] for k in keys)
   169	        losses = sum(lm[k]["accurate"] and (not rm[k]["accurate"]) for k in keys)
   170	        ties = len(keys) - wins - losses
   171	        delta = pct(sum(rm[k]["accurate"] for k in keys), len(keys)) - pct(
   172	            sum(lm[k]["accurate"] for k in keys), len(keys))
   173	        families = sorted({lm[k]["family"] for k in keys})
