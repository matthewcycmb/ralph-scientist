   210	def content_words(text: str):
   211	    return {w for w in re.findall(r"[a-z]+", text.lower())
   212	            if w not in STOPWORDS}
   213	
   214	
   215	def prune(doc_sentences, question: str):
   216	    """Keyword-overlap pruning: keep sentences sharing >= 2 content words
   217	    with the question; if fewer than PRUNE_FLOOR survive, keep the top-8 by
   218	    overlap (ties broken by original order). Original order is preserved."""
   219	    qw = content_words(question)
   220	    scored = [(len(qw & content_words(s)), i, s)
   221	              for i, s in enumerate(doc_sentences)]
   222	    kept = [(i, s) for ov, i, s in scored if ov >= PRUNE_MIN_OVERLAP]
   223	    if len(kept) < PRUNE_FLOOR:
   224	        best = sorted(scored, key=lambda t: (-t[0], t[1]))[:PRUNE_FLOOR]
   225	        kept = sorted((i, s) for _, i, s in best)
   226	    return [s for _, s in kept]
