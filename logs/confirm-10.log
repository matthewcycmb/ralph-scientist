    42	def score_record(rec: dict, raw: str) -> dict:
    43	    answer = clean_output(raw)
    44	    target = rec["target_code"]
    45	    distractor = rec["distractor_code"]
    46	    target_present = re.search(
    47	        rf"(?<![A-Z0-9]){re.escape(target)}(?![A-Z0-9])", answer) is not None
    48	    distractor_present = re.search(
    49	        rf"(?<![A-Z0-9]){re.escape(distractor)}(?![A-Z0-9])", answer) is not None
    50	    code_only = CODE_RE.fullmatch(answer) is not None
    51	    return {
    52	        **rec,
    53	        "answer": answer,
    54	        "accurate": target_present and not distractor_present,
    55	        "exact_target": answer == target,
    56	        "code_only": code_only,
    57	        "distractor_capture": distractor_present and not target_present,
    58	        "invalid": target_present == distractor_present,
    59	        "extra_tokens": (target_present != distractor_present) and not code_only,
    60	    }
    61	
    62	
    63	def pct(successes: int, n: int) -> float:
    64	    return 100.0 * successes / n if n else 0.0
    65	
    66	
    67	def percentile(sorted_values: list, quantile: float) -> float:
    68	    """Linearly interpolated quantile of an already sorted nonempty sequence."""
    69	    index = quantile * (len(sorted_values) - 1)
    70	    lower = int(index)
    71	    upper = min(lower + 1, len(sorted_values) - 1)
    72	    weight = index - lower
    73	    return sorted_values[lower] * (1.0 - weight) + sorted_values[upper] * weight
    74	
    75	
    76	def cluster_bootstrap_interval(contributions: list) -> tuple:
    77	    """Exact percentile interval from resampling observed scenario families.
    78	
    79	    Each contribution is ``(numerator, denominator)`` for one family.  We
    80	    enumerate every ordered bootstrap sample of the observed family clusters,
    81	    which is practical because the frozen grid contains at most six families.
    82	    This avoids treating repeated positions, fillers, and variants from one
    83	    generated scenario as independent observations.
    84	    """
    85	    if not contributions:
    86	        return 0.0, 0.0
    87	    cluster_count = len(contributions)
    88	    estimates = []
    89	    for sample in itertools.product(range(cluster_count), repeat=cluster_count):
    90	        numerator = sum(contributions[i][0] for i in sample)
    91	        denominator = sum(contributions[i][1] for i in sample)
    92	        estimates.append(pct(numerator, denominator))
    93	    estimates.sort()
    94	    tail = (1.0 - CONFIDENCE) / 2.0
    95	    return percentile(estimates, tail), percentile(estimates, 1.0 - tail)
