   123	    def add_accuracy(prefix, rows, desc):
   124	        n = len(rows)
   125	        successes = sum(r["accurate"] for r in rows)
   126	        families = sorted({r["family"] for r in rows})
   127	        contributions = [
   128	            (sum(r["accurate"] for r in rows if r["family"] == family),
   129	             sum(1 for r in rows if r["family"] == family))
   130	            for family in families
   131	        ]
   132	        low, high = cluster_bootstrap_interval(contributions)
   133	        add(prefix + "Count", n, "count", f"probe count for {desc}")
   134	        add(prefix + "FamilyCount", len(families), "count",
   135	            f"scenario-family count for {desc}")
   136	        add(prefix + "Accuracy", pct(successes, n), "pct", desc, ".1f")
