   232	def count_tokens(prompt_file: Path) -> int:
   233	    global _TOKENIZE_CALLS
   234	    _TOKENIZE_CALLS += 1
   235	    res = subprocess.run(
   236	        ["llama-tokenize", "-m", str(MODEL), "-f", str(prompt_file),
   237	         "--show-count", "--log-disable"],
   238	        capture_output=True, text=True)
   239	    if res.returncode != 0:
   240	        raise SystemExit(f"llama-tokenize failed: {res.stderr[-400:]}")
   241	    m = re.search(r"Total number of tokens:\s*(\d+)", res.stdout + res.stderr)
   242	    if m:
   243	        return int(m.group(1))
   244	    # Fallback: one token per output line of the form "  123 -> '...'".
   245	    return len(re.findall(r"^\s*\d+\s*->", res.stdout, re.M))
