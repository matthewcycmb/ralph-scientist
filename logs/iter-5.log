+        denominator = sum(contributions[i][1] for i in sample)
+        estimates.append(pct(numerator, denominator))
+    estimates.sort()
+    tail = (1.0 - CONFIDENCE) / 2.0
+    return percentile(estimates, tail), percentile(estimates, 1.0 - tail)
 
 
