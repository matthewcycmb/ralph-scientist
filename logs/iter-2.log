+& \positionFourMiddleAccuracy{} [\positionFourMiddleAccuracyLow{}, \positionFourMiddleAccuracyHigh{}]
+& \positionFourEndAccuracy{} [\positionFourEndAccuracyLow{}, \positionFourEndAccuracyHigh{}] \\
+\tierEightTokens{}
