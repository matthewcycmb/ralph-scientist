   137	            sum(lm[k]["accurate"] for k in keys), len(keys))
   138	        comparison = f"paired {right_label} minus {left_label} comparison"
   139	        add(prefix + "Denominator", len(keys), "count", f"matched pairs in {comparison}")
   140	        add(prefix + "Wins", wins, "count", f"accuracy gains in {comparison}")
   141	        add(prefix + "Losses", losses, "count", f"accuracy losses in {comparison}")
   142	        add(prefix + "Ties", ties, "count", f"accuracy ties in {comparison}")
   143	        add(prefix + "Change", delta, "raw",
   144	            f"accuracy change in percentage points for {comparison}", ".1f")
   145	
   146	    add("sampleSize", len(scored), "count", "total completed probes scored")
   147	    add("manifestProbeCount", len(records), "count", "total probes in the manifest")
   148	    add("missingProbeCount", len(missing), "count", "manifest probes without completed raw outputs")
   149	    add("confidenceLevel", 95.0, "pct", "nominal level of every Wilson confidence interval", ".0f")
   150	    add("cpuBudgetMinutes", 45, "count", "full clean-room probe budget in minutes")
   151	
   152	    full = [r for r in scored if r["variant"] == "full" and r["style"] == "para"]
   153	    tier_words = {"t2k": "Two", "t4k": "Four", "t8k": "Eight"}
   154	    for tier, word in tier_words.items():
