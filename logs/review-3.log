   128	class Family:
   129	    """One scenario family. Nothing here depends on target position."""
   130	
   131	    def __init__(self, idx: int):
   132	        rng = rng_for(f"family-{idx}")
   133	        self.idx = idx
   134	        picks = rng.sample(COMPANIES, 2)
   135	        self.company, self.d_company = picks
   136	        self.target_code = make_code(rng)
   137	        self.distractor_code = make_code(rng)
   138	        while self.distractor_code == self.target_code:
   139	            self.distractor_code = make_code(rng)
   140	        # Distractor depth: independent of target position, fixed per family.
   141	        self.distractor_depth = rng.choice([0.25, 0.75])
   142	        # Paraphrase design (NoLiMa-style): the QUESTION shares its surface
   143	        # phrasing with the DISTRACTOR clause; the target clause states the
   144	        # answer in different words, so literal matching favors the wrong code.
   145	        self.question = (f"What is the renewal code required to extend the "
   146	                         f"contract with {self.company}?")
   147	        self.needle_para = (f"{self.company}'s master supply agreement "
   148	                            f"carries the renewal identifier "
   149	                            f"{self.target_code}.")
   150	        self.distractor_para = (f"The renewal code required to extend the "
   151	                                f"contract with {self.d_company} is "
   152	                                f"{self.distractor_code}.")
   153	        # Literal control: needle phrased exactly like the question, the
   154	        # look-alike clause phrased obliquely.
   155	        self.needle_lit = (f"The renewal code required to extend the "
   156	                           f"contract with {self.company} is "
   157	                           f"{self.target_code}.")
   158	        self.distractor_lit = (f"{self.d_company}'s master supply agreement "
   159	                               f"carries the renewal identifier "
   160	                               f"{self.distractor_code}.")
   161	
   162	    def clauses(self, style: str):
   163	        if style == "lit":
   164	            return self.needle_lit, self.distractor_lit
   165	        return self.needle_para, self.distractor_para
   166	
   167	
   168	def filler_sentences(family: Family, tier: str, kind: str, count: int):
   169	    """Deterministic filler; seed excludes position by construction."""
   170	    rng = rng_for(f"filler-{family.idx}-{tier}-{kind}")
   171	    used = {family.company, family.d_company}
   172	    out = []
   173	    for i in range(count):
   174	        if kind == "irr":
   175	            t = IRRELEVANT_TEMPLATES[i % len(IRRELEVANT_TEMPLATES)]
   176	            out.append(t.format(place=rng.choice(IRR_PLACES),
   177	                                adj=rng.choice(IRR_ADJS)))
   178	        else:
   179	            co = rng.choice([c for c in COMPANIES if c not in used])
   180	            t = RELEVANT_TEMPLATES[i % len(RELEVANT_TEMPLATES)]
   181	            out.append(t.format(co=co, code=make_code(rng)))
   182	    return out
   183	
   184	
   185	def assemble(filler: list, needle: str, distractor: str,
   186	             target_depth: float, distractor_depth: float) -> list:
   187	    """Insert distractor then needle at fractional depths of the final doc."""
   188	    doc = list(filler)
   189	    n = len(doc) + 2
   190	    d_at = min(int(round(distractor_depth * n)), n - 2)
   191	    t_at = min(int(round(target_depth * n)), n - 1)
   192	    if t_at == d_at:
   193	        t_at += 1
   194	    for pos, sent in sorted([(d_at, distractor), (t_at, needle)],
   195	                            reverse=True):
   196	        doc.insert(min(pos, len(doc)), sent)
   197	    return doc
   198	
   199	
   200	def build_prompt(doc_sentences, question: str) -> str:
   201	    parts = [f"<|im_start|>system\n{SYSTEM_MSG}<|im_end|>\n<|im_start|>user\n"]
   202	    if doc_sentences:
   203	        parts.append("Document:\n" + " ".join(doc_sentences) + "\n\n")
   204	    parts.append(f"Question: {question}\nAnswer with the code only.<|im_end|>"
   205	                 f"\n<|im_start|>assistant\n")
   206	    return "".join(parts)
   207	
   208	
   209	def content_words(text: str):
   210	    return {w for w in re.findall(r"[a-z]+", text.lower())
   211	            if w not in STOPWORDS}
   212	
   213	
   214	def prune(doc_sentences, question: str):
   215	    """Keyword-overlap pruning: keep sentences sharing >= 2 content words
   216	    with the question; if fewer than PRUNE_FLOOR survive, keep the top-8 by
   217	    overlap (ties broken by original order). Original order is preserved."""
   218	    qw = content_words(question)
   219	    scored = [(len(qw & content_words(s)), i, s)
   220	              for i, s in enumerate(doc_sentences)]
   220	              for i, s in enumerate(doc_sentences)]
   221	    kept = [(i, s) for ov, i, s in scored if ov >= PRUNE_MIN_OVERLAP]
   222	    if len(kept) < PRUNE_FLOOR:
   223	        best = sorted(scored, key=lambda t: (-t[0], t[1]))[:PRUNE_FLOOR]
   224	        kept = sorted((i, s) for _, i, s in best)
   225	    return [s for _, s in kept]
