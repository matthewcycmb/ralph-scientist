   210	    pair_fields = ("family", "filler", "position", "style")
   211	    fm, pm = keyed(full_four, pair_fields), keyed(pruned, pair_fields)
   212	    prune_keys = sorted(set(fm) & set(pm))
   213	    paired_full = [fm[k] for k in prune_keys]
   214	    paired_pruned = [pm[k] for k in prune_keys]
   215	    add_accuracy("pruningFull", paired_full,
   216	                 "normalized full-context accuracy in matched pruning scenarios")
   217	    add_accuracy("pruningPruned", paired_pruned,
   218	                 "normalized pruned-context accuracy in matched pruning scenarios")
   219	    add_paired("pruning", paired_full, paired_pruned, pair_fields,
   220	               "full context", "keyword-pruned context")
   221	
   222	    literal = [r for r in scored if r["style"] == "lit"]
   223	    para_controls = [r for r in full if r["tier"] == "t2k" and
   224	                     r["position"] == "mid" and r["filler"] == "irr"]
   225	    add_accuracy("literalControl", literal, "normalized literal-control accuracy")
   226	    add_accuracy("paraphraseControl", para_controls,
   227	                 "normalized accuracy in the matched paraphrase-control scenarios")
   228	    add_paired("literalControl", para_controls, literal, ("family",),
   229	               "paraphrase wording", "literal wording")
   230	    closed = [r for r in scored if r["variant"] == "closedbook"]
   231	    add_accuracy("closedBook", closed, "normalized closed-book accuracy")
   232	
   233	    add_accuracy("overall", scored, "normalized accuracy across all completed probes")
   234	    add_binary_rate("exactTarget", scored, "exact_target",
   235	                    "responses containing exactly the target code and nothing else")
   236	    add_binary_rate("exactOutputCompliance", scored, "code_only",
   237	                    "responses containing exactly one code and nothing else")
   238	    add_binary_rate("distractorCapture", scored, "distractor_capture",
   239	                    "responses containing the distractor code but not the target code")
   240	    add_binary_rate("invalidOutput", scored, "invalid",
   241	                    "responses containing both expected codes or neither expected code")
   242	    add_binary_rate("extraTokenOutput", scored, "extra_tokens",
   243	                    "responses containing one expected code plus extra output")
   244	
   245	    result = {
   246	        "meta": {
   247	            "generated_by": SCRIPT,
   248	            "data": "data/probes/ (raw outputs of the frozen model in data/models/)",
   249	            "model_file": meta.get("model_file"),
   250	            "model_sha256": meta.get("model_sha256"),
   251	            "manifest_complete": bool(meta.get("manifest_complete")) and not missing,
   252	            "missing_probe_count": len(missing),
   253	            "scoring": {
   254	                "transport_cleanup": "strip the fixed llama.cpp EOF trailer and surrounding whitespace",
   255	                "exact_output_compliance": "cleaned output is exactly one AA-000 code",
   256	                "normalized_accuracy": "target code present and distractor code absent",
   257	                "distractor_capture": "distractor code present and target code absent",
   258	                "invalid_output": "both expected codes or neither expected code present",
   259	                "extra_token_output": "exactly one expected code present but output is not code-only",
   260	            },
   261	            "missing_probe_ids": missing,
   262	        },
   263	        "values": dict(sorted(values.items())),
   264	    }
   265	    tmp = RESULTS.with_suffix(".json.tmp")
   266	    tmp.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
   267	    tmp.replace(RESULTS)
   268	    print(f"run_all: scored {len(scored)}/{len(records)} probes; "
   269	          f"wrote {len(values)} values to results.json")
   270	    return 0
   271	
