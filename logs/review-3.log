   111	def rng_for(tag: str) -> random.Random:
   112	    return random.Random(zlib.crc32(tag.encode("utf-8")))
   113	
   114	
   115	def make_code(rng: random.Random) -> str:
   116	    letters = "".join(rng.choice("BCDFGHJKLMNPQRSTVWXZ") for _ in range(2))
   117	    return f"{letters}-{rng.randrange(100, 999)}"
   118	
   119	
   120	def model_sha256() -> str:
   121	    for line in CHECKSUMS.read_text().splitlines():
   122	        parts = line.split()
   123	        if len(parts) >= 2 and parts[-1].endswith(MODEL.name):
   124	            return parts[0]
   125	    raise SystemExit(f"run_probes: {MODEL.name} not found in {CHECKSUMS}")
