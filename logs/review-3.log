     1	#!/usr/bin/env python3
     2	"""Score frozen probe outputs and build the paper's numeric result registry.
     3	
     4	This is the cheap tier of the pipeline.  It reads only the probe manifest and
     5	one raw output file per completed probe.  It never reads prompts or invokes the
     6	model.  Incomplete manifests are resumable: missing cells are reported in
     7	metadata and excluded from every aggregate.
     8	
     9	Scoring rules
    10	-------------
    11	llama-completion appends a fixed ``> EOF by user`` transport trailer.  We
    12	remove that trailer and surrounding whitespace before scoring.  A response is
    13	code-only compliant when the remaining text is exactly one code of the form
    14	``AA-000``.  Normalized accuracy requires the target code to occur and the
    15	distractor code not to occur; this deliberately gives credit to an otherwise
    16	correct response with extra words.  A distractor capture reverses those two
    17	conditions.  A response is invalid when it contains both expected codes or
    18	neither.  Extra-token responses contain exactly one expected code but are not
    19	code-only compliant.
    20	"""
    21	import json
    22	import math
    23	import re
    24	import sys
    25	from pathlib import Path
    26	
    27	
    28	ROOT = Path(__file__).resolve().parent.parent
    29	MANIFEST = ROOT / "data/probes/manifest.json"
    30	RESULTS = ROOT / "results.json"
    31	SCRIPT = "analysis/run_all.py"
    32	CODE_RE = re.compile(r"(?<![A-Z0-9])[A-Z]{2}-[0-9]{3}(?![A-Z0-9])")
    33	EOF_RE = re.compile(r"(?:\r?\n)?\s*> EOF by user[\s\S]*\Z")
    34	Z = 1.96
    35	
    36	
    37	def clean_output(raw: str) -> str:
    38	    """Remove llama.cpp's transport trailer, not model-generated prose."""
    39	    return EOF_RE.sub("", raw).strip()
    40	
    41	
    42	def score_record(rec: dict, raw: str) -> dict:
    43	    answer = clean_output(raw)
    44	    target = rec["target_code"]
    45	    distractor = rec["distractor_code"]
    46	    target_present = re.search(
    47	        rf"(?<![A-Z0-9]){re.escape(target)}(?![A-Z0-9])", answer) is not None
    48	    distractor_present = re.search(
    49	        rf"(?<![A-Z0-9]){re.escape(distractor)}(?![A-Z0-9])", answer) is not None
    50	    code_only = CODE_RE.fullmatch(answer) is not None
    51	    return {
    52	        **rec,
    53	        "answer": answer,
    54	        "accurate": target_present and not distractor_present,
    55	        "exact_target": answer == target,
    56	        "code_only": code_only,
    57	        "distractor_capture": distractor_present and not target_present,
    58	        "invalid": target_present == distractor_present,
    59	        "extra_tokens": (target_present != distractor_present) and not code_only,
    60	    }
    61	
    62	
    63	def pct(successes: int, n: int) -> float:
    64	    return 100.0 * successes / n if n else 0.0
    65	
    66	
    67	def wilson(successes: int, n: int) -> tuple:
    68	    """Two-sided Wilson score interval using the fixed normal critical value."""
    69	    if not n:
    70	        return 0.0, 0.0
    71	    p = successes / n
    72	    denom = 1.0 + Z * Z / n
    73	    centre = (p + Z * Z / (2.0 * n)) / denom
    74	    radius = (Z / denom) * math.sqrt(
    75	        p * (1.0 - p) / n + Z * Z / (4.0 * n * n))
    76	    return 100.0 * max(0.0, centre - radius), 100.0 * min(1.0, centre + radius)
    77	
    78	
    79	def main() -> int:
    80	    if not MANIFEST.is_file():
    81	        print("run_all: data/probes/manifest.json is missing", file=sys.stderr)
    82	        return 1
    83	    manifest = json.loads(MANIFEST.read_text())
    84	    meta = manifest.get("meta", {})
    85	    records = manifest.get("probes", {})
    86	    scored = []
    87	    missing = []
    88	    for probe_id in sorted(records):
    89	        rec = records[probe_id]
    90	        output = ROOT / rec["output_file"]
    91	        if rec.get("status") != "done" or not output.is_file():
    92	            missing.append(probe_id)
    93	            continue
    94	        scored.append(score_record(rec, output.read_text()))
    95	
    96	    values = {}
    97	
    98	    def add(name, value, unit, desc, fmt=None):
    99	        entry = {"value": value, "unit": unit, "desc": desc, "script": SCRIPT}
   100	        if fmt is not None:
   101	            entry["fmt"] = fmt
   102	        values[name] = entry
   103	
   104	    def add_accuracy(prefix, rows, desc):
   105	        n = len(rows)
   106	        successes = sum(r["accurate"] for r in rows)
   107	        low, high = wilson(successes, n)
   108	        add(prefix + "Count", n, "count", f"probe count for {desc}")
   109	        add(prefix + "Accuracy", pct(successes, n), "pct", desc, ".1f")
   110	        add(prefix + "AccuracyLow", low, "pct",
   111	            f"Wilson lower confidence bound for {desc}", ".1f")
   112	        add(prefix + "AccuracyHigh", high, "pct",
   113	            f"Wilson upper confidence bound for {desc}", ".1f")
   114	
   115	    def add_binary_rate(prefix, rows, field, desc):
   116	        n = len(rows)
   117	        successes = sum(r[field] for r in rows)
   118	        low, high = wilson(successes, n)
   119	        add(prefix + "Count", successes, "count", f"count of {desc}")
   120	        add(prefix + "Rate", pct(successes, n), "pct", desc, ".1f")
   121	        add(prefix + "RateLow", low, "pct",
   122	            f"Wilson lower confidence bound for {desc}", ".1f")
   123	        add(prefix + "RateHigh", high, "pct",
   124	            f"Wilson upper confidence bound for {desc}", ".1f")
   125	
   126	    def keyed(rows, fields):
   127	        return {tuple(r[f] for f in fields): r for r in rows}
