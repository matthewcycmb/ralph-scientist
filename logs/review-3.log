   228	_TOKENIZE_CALLS = 0
   229	
   230	
   231	def count_tokens(prompt_file: Path) -> int:
   232	    global _TOKENIZE_CALLS
   233	    _TOKENIZE_CALLS += 1
   234	    res = subprocess.run(
   235	        ["llama-tokenize", "-m", str(MODEL), "-f", str(prompt_file),
   236	         "--show-count", "--log-disable"],
   237	        capture_output=True, text=True)
   238	    if res.returncode != 0:
   239	        raise SystemExit(f"llama-tokenize failed: {res.stderr[-400:]}")
   240	    m = re.search(r"Total number of tokens:\s*(\d+)", res.stdout + res.stderr)
   241	    if m:
   242	        return int(m.group(1))
   243	    # Fallback: one token per output line of the form "  123 -> '...'".
   244	    return len(re.findall(r"^\s*\d+\s*->", res.stdout, re.M))
   245	
   246	
   247	def sha256_text(text: str) -> str:
   248	    return hashlib.sha256(text.encode("utf-8")).hexdigest()
   249	
   250	
   251	def write_atomic(path: Path, text: str):
   252	    tmp = path.with_suffix(path.suffix + ".tmp")
   253	    tmp.write_text(text)
   254	    tmp.replace(path)
   255	
   256	
   257	class Grid:
   258	    """Generates every prompt, sizes tiers with the real tokenizer, and
   259	    yields probe records in cheapest-first order."""
   260	
   261	    def __init__(self):
   262	        self.families = {i: Family(i) for i in
   263	                         range(max(nf for _, _, nf, _ in TIERS))}
   264	        self.probes = {}          # id -> record
   265	        self._ratio = {}          # (tier, kind) -> chars per token estimate
   266	        self._docs = {}           # scenario key -> sentence list
   267	        # Caches from the previous manifest: deterministic generation means a
   268	        # matching prompt sha can reuse its measured token count, and sizing
   269	        # counts can skip the tokenizer loop entirely on resume.
   270	        self._old_measown = {}    # prompt_sha256 -> measured tokens
   271	        self._sizing_cache = {}   # sizing key -> filler sentence count
   272	        old = load_manifest()
   273	        if old:
   274	            for rec in old.get("probes", {}).values():
   275	                if rec.get("measured_prompt_tokens"):
   276	                    self._old_measown[rec["prompt_sha256"]] = \
   277	                        rec["measured_prompt_tokens"]
   278	            self._sizing_cache = dict(old.get("meta", {})
   279	                                      .get("sizing_counts", {}))
   280	
   281	    def _sized_filler(self, fam, tier_label, nominal, kind, probe_id):
   282	        """Iteratively size filler so the mid-position render measures within
   283	        SIZE_TOLERANCE of nominal tokens. Estimates seed the loop; the real
   284	        tokenizer decides. Returns (filler, measured_mid_tokens)."""
   285	        cached = self._sizing_cache.get(probe_id)
   286	        if cached:
   287	            return filler_sentences(fam, tier_label, kind, cached), None
   288	        ratio = self._ratio.get((tier_label, kind), 4.0)
   289	        needle, distractor = fam.clauses("para")
   290	        overhead = len(build_prompt([], fam.question))
   291	        count = max(10, int((nominal * ratio - overhead) /
   292	                            (ratio * 18)))  # ~18 tokens/sentence to start
   293	        tmp = PROMPT_DIR / f"_sizing-{probe_id}.txt"
   294	        measured = 0
   295	        for _ in range(6):
   296	            filler = filler_sentences(fam, tier_label, kind, count)
   297	            doc = assemble(filler, needle, distractor,
   298	                           POSITIONS["mid"], fam.distractor_depth)
   299	            write_atomic(tmp, build_prompt(doc, fam.question))
   300	            measured = count_tokens(tmp)
   301	            self._ratio[(tier_label, kind)] = (
   302	                tmp.stat().st_size / max(measured, 1))
   303	            if abs(measured - nominal) <= SIZE_TOLERANCE * nominal:
   304	                break
   305	            count = max(10, int(round(count * nominal / max(measured, 1))))
   306	        tmp.unlink(missing_ok=True)
   307	        self._sizing_cache[probe_id] = count
   308	        return filler_sentences(fam, tier_label, kind, count), measured
   309	
   310	    def _add(self, pid, prompt, est_s, **fields):
   311	        pf = PROMPT_DIR / f"{pid}.txt"
   312	        if not pf.exists() or pf.read_text() != prompt:
   313	            write_atomic(pf, prompt)
   314	        rec = dict(id=pid, prompt_file=str(pf.relative_to(ROOT)),
   315	                   output_file=str((OUT_DIR / f"{pid}.txt")
   316	                                   .relative_to(ROOT)),
   317	                   prompt_sha256=sha256_text(prompt),
   318	                   est_seconds=est_s, **fields)
   319	        self.probes[pid] = rec
   320	
   321	    def generate(self):
   322	        PROMPT_DIR.mkdir(parents=True, exist_ok=True)
   323	        OUT_DIR.mkdir(parents=True, exist_ok=True)
   324	        for tier_label, nominal, n_fam, est_s in TIERS:
   325	            for fi in range(n_fam):
   326	                fam = self.families[fi]
   327	                for kind in FILLERS:
   328	                    key = f"{tier_label}-f{fi}-{kind}"
   329	                    filler, _ = self._sized_filler(
   330	                        fam, tier_label, nominal, kind, key)
   331	                    for pos, depth in POSITIONS.items():
   332	                        needle, distractor = fam.clauses("para")
   333	                        doc = assemble(filler, needle, distractor, depth,
   334	                                       fam.distractor_depth)
   335	                        pid = f"{tier_label}-f{fi}-{pos}-{kind}-full"
   336	                        prompt = build_prompt(doc, fam.question)
   337	                        self._docs[pid] = doc
   338	                        self._add(pid, prompt, est_s, family=fi,
   339	                                  tier=tier_label, nominal_tokens=nominal,
   340	                                  style="para", filler=kind, position=pos,
   341	                                  variant="full",
   342	                                  target_code=fam.target_code,
   343	                                  distractor_code=fam.distractor_code)
   344	                        if tier_label == PRUNED_TIER:
   345	                            pdoc = prune(doc, fam.question)
   346	                            ppid = f"{tier_label}-f{fi}-{pos}-{kind}-pruned"
   347	                            self._add(ppid, build_prompt(pdoc, fam.question),
   348	                                      6, family=fi, tier=tier_label,
   349	                                      nominal_tokens=nominal, style="para",
   350	                                      filler=kind, position=pos,
   351	                                      variant="pruned",
   352	                                      target_code=fam.target_code,
   353	                                      distractor_code=fam.distractor_code)
   354	        # Literal control: smallest tier, hardest position, irrelevant
   355	        # filler. Reuses the paraphrase cell's sizing key, so the filler is
   356	        # IDENTICAL to the matching paraphrase scenario; the two probes
   357	        # differ only in how the needle and distractor clauses are phrased.
   358	        tier_label, nominal, n_fam, est_s = TIERS[0]
   359	        for fi in range(n_fam):
   360	            fam = self.families[fi]
   361	            filler, _ = self._sized_filler(fam, tier_label, nominal, "irr",
   362	                                           f"{tier_label}-f{fi}-irr")
   363	            needle, distractor = fam.clauses("lit")
   364	            doc = assemble(filler, needle, distractor, POSITIONS["mid"],
   365	                           fam.distractor_depth)
   366	            self._add(f"{tier_label}-f{fi}-mid-irr-lit",
   367	                      build_prompt(doc, fam.question), est_s, family=fi,
   368	                      tier=tier_label, nominal_tokens=nominal, style="lit",
   369	                      filler="irr", position="mid", variant="full",
   370	                      target_code=fam.target_code,
   371	                      distractor_code=fam.distractor_code)
   372	        # Closed-book baseline: question only, no document.
   373	        for fi in range(CLOSED_BOOK_FAMILIES):
   374	            fam = self.families[fi]
   375	            self._add(f"cb-f{fi}", build_prompt([], fam.question), 3,
   376	                      family=fi, tier="cb", nominal_tokens=0, style="para",
   377	                      filler="none", position="none", variant="closedbook",
   378	                      target_code=fam.target_code,
   379	                      distractor_code=fam.distractor_code)
   380	
   381	    def measure_all(self):
   382	        for rec in self.probes.values():
   383	            if rec.get("measured_prompt_tokens"):
   384	                continue
   385	            cached = self._old_measown.get(rec["prompt_sha256"])
   386	            rec["measured_prompt_tokens"] = cached or count_tokens(
   387	                ROOT / rec["prompt_file"])
   388	
   389	    def order(self):
   390	        return sorted(self.probes.values(), key=lambda r: (r["est_seconds"],
   391	                                                           r["id"]))
   392	
   393	
   394	def load_manifest():
   395	    if MANIFEST.exists():
   396	        return json.loads(MANIFEST.read_text())
   397	    return None
   398	
   399	
   400	def save_manifest(grid: Grid):
   401	    done = {pid: (ROOT / rec["output_file"]).exists()
   402	            for pid, rec in grid.probes.items()}
   403	    for pid, rec in grid.probes.items():
   404	        rec["status"] = "done" if done[pid] else "pending"
   405	    manifest = {
   406	        "meta": {
   407	            "generated_by": "analysis/run_probes.py",
   408	            "model_file": str(MODEL.relative_to(ROOT)),
   409	            "model_sha256": model_sha256(),
   410	            "llama_command": "llama-completion -m <model> -f <prompt> "
   411	                             + " ".join(LLAMA_ARGS),
   412	            "grid_version": "v1",
   413	            "total_probes": len(grid.probes),
   414	            "done_probes": sum(done.values()),
   415	            "manifest_complete": all(done.values()),
   416	            "sizing_counts": dict(sorted(grid._sizing_cache.items())),
   417	        },
   418	        "probes": {pid: grid.probes[pid] for pid in sorted(grid.probes)},
   419	    }
   420	    PROBE_DIR.mkdir(parents=True, exist_ok=True)
   421	    write_atomic(MANIFEST, json.dumps(manifest, indent=1, sort_keys=True))
